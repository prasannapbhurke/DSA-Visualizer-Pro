{
  "version": 2,
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "postgres_schema.sql",
          "public/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/admin",
      "dest": "/api"
    },
    {
      "src": "/admin/(.*)",
      "dest": "/api"
    },
    {
      "src": "/uploads/(.*)",
      "dest": "/api"
    },
    {
      "src": "/(.*)",
      "dest": "/api"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
