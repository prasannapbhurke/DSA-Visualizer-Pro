<resources>
    <style name="Widget.DSA.Button.Primary" parent="Widget.Material3.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.DSA.Button.Secondary" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.DSA.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="iconPadding">10dp</item>
    </style>

    <style name="Widget.DSA.Button.PillSecondary" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">46dp</item>
        <item name="cornerRadius">24dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.DSA.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAllCaps">false</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.DSA.Button.CodeTool" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">6dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
    </style>

    <style name="Widget.DSA.Button.Toggle" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">44dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
    </style>

    <style name="Widget.DSA.Button.ModeTab" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="strokeWidth">1dp</item>
        <item name="iconPadding">8dp</item>
    </style>

    <style name="Widget.DSA.Button.Playback" parent="Widget.Material3.Button.TonalButton">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">10sp</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetLeft">0dp</item>
        <item name="android:insetRight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">0dp</item>
        <item name="android:paddingEnd">0dp</item>
        <item name="cornerRadius">14dp</item>
        <item name="backgroundTint">@color/player_button_background</item>
        <item name="android:textColor">@color/player_button_foreground</item>
        <item name="iconTint">@color/player_button_foreground</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">20dp</item>
        <item name="strokeColor">@color/player_control_neutral_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/player_control_neutral_stroke</item>
        <item name="android:elevation">1dp</item>
    </style>

    <style name="Widget.DSA.Button.Playback.Restart" parent="Widget.DSA.Button.Playback">
        <item name="backgroundTint">@color/player_restart_background</item>
        <item name="android:textColor">@color/player_restart_foreground</item>
        <item name="iconTint">@color/player_restart_foreground</item>
        <item name="strokeColor">@color/player_reset_stroke</item>
        <item name="rippleColor">@color/player_reset_stroke</item>
    </style>

    <style name="Widget.DSA.Button.Playback.Primary" parent="Widget.DSA.Button.Playback">
        <item name="android:minHeight">48dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="backgroundTint">@color/player_primary_background</item>
        <item name="android:textColor">@color/player_primary_foreground</item>
        <item name="iconTint">@color/player_primary_foreground</item>
        <item name="iconSize">22dp</item>
        <item name="strokeColor">@color/player_play_stroke</item>
        <item name="strokeWidth">1dp</item>
        <item name="rippleColor">@color/player_play_stroke</item>
        <item name="android:elevation">4dp</item>
    </style>

    <style name="Widget.DSA.Button.Playback.Action" parent="Widget.DSA.Button.Playback">
        <item name="iconSize">18dp</item>
    </style>

    <style name="Widget.DSA.TextInputLayout.Search" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="boxBackgroundColor">@color/surface_panel</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
    </style>
</resources>
