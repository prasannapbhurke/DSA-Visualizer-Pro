    <string name="vis_desc_tree_traversal">Tree Traversal is following %1$s order, so the visit sequence changes with the selected mode.</string>
    <string name="vis_desc_bubble_sort">Bubble Sort compares neighbors and pushes the largest unsorted value to the end in each pass.</string>
    <string name="vis_desc_selection_sort">Selection Sort searches for the smallest unsorted value and places it into the next sorted position.</string>
    <string name="vis_desc_insertion_sort">Insertion Sort grows the sorted part by shifting larger values and inserting the current value in place.</string>
    <string name="vis_desc_warshall">Warshall checks whether going through the current intermediate vertex makes one more pair of nodes reachable.</string>
    <string name="vis_desc_floyd">This matrix step checks whether the current intermediate vertex gives a cheaper path between two vertices.</string>
    <string name="vis_desc_heap">Heap operations keep the largest value at the root, then restore heap order with percolate-up or percolate-down steps.</string>
    <string name="vis_desc_merging">Merging keeps comparing the first remaining items of the left and right sorted lists, then writes the smaller one into the output.</string>
    <string name="vis_desc_merge_sort">Merge Sort first treats small runs as sorted, then merges larger and larger runs until the whole array becomes sorted.</string>
    <string name="vis_desc_radix_sort">Radix Sort finishes one digit pass at a time, so the buckets for ones, tens, and higher places settle the final order.</string>
    <string name="vis_desc_follow_step">Follow the current step carefully.</string>

