    <string name="vis_desc_binary_range">Binary Search marks the current search range first using low and high.</string>
    <string name="vis_desc_binary_inspect">Now we inspect the middle value of the current range before deciding which half to keep.</string>
    <string name="vis_desc_binary_ruled_out">After the middle comparison, one half is ruled out and the search range becomes smaller.</string>
