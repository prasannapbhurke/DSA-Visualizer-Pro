<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.drawerlayout.widget.DrawerLayout
        android:id="@+id/home_drawer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/main_background">

        <LinearLayout
            android:id="@+id/home_root"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="horizontal"
            android:padding="14dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="14dp"
                android:layout_weight="30"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/menu_button"
                        android:layout_width="42dp"
                        android:layout_height="42dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/home_menu_open"
                        android:padding="10dp"
                        android:src="@drawable/ic_menu_lines"
                        android:tint="@color/text_primary_bright" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="@string/home_title"
                        android:textColor="@color/text_primary_bright"
                        android:textSize="22sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/progress_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/topics_explored_initial"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/continue_learning_card"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@color/surface_panel_info"
                    app:cardCornerRadius="18dp"
                    app:strokeColor="@color/surface_stroke_muted"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="14dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/home_continue_learning_title"
                            android:textColor="@color/text_primary_soft"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/continue_learning_text"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="6dp"
                            android:maxLines="1"
                            android:text="@string/home_continue_learning_empty"
                            android:textColor="@color/text_primary_bright"
                            android:textSize="17sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/continue_learning_subtext"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="5dp"
                            android:maxLines="2"
                            android:text="@string/home_continue_learning_subtext"
                            android:textColor="@color/text_muted_soft"
                            android:textSize="12sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.textfield.TextInputLayout
                    style="@style/Widget.DSA.TextInputLayout.Search"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:hint="@string/search_categories_hint">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/search_input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_primary_bright" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/category_recycler_view"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="70"
                android:clipToPadding="false"
                android:paddingBottom="8dp" />
        </LinearLayout>

        <ScrollView
            android:id="@+id/home_drawer_scroll"
            android:layout_width="320dp"
            android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="@color/slate_900"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/drawer_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_account_section_title" android:textColor="@color/text_support_soft" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/account_mode_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:background="@drawable/drawer_badge_background" android:paddingLeft="10dp" android:paddingTop="4dp" android:paddingRight="10dp" android:paddingBottom="4dp" android:text="@string/home_account_guest_badge" android:textColor="@color/text_hint_blue" android:textSize="12sp" android:textStyle="bold" />
                <TextView android:id="@+id/account_status_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_guest_default_name" android:textColor="@color/text_support" android:textSize="13sp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/google_sign_in_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/home_google_sign_in" app:icon="@drawable/ic_google_mark" app:iconGravity="textStart" app:iconPadding="10dp" />
                <com.google.android.material.button.MaterialButton android:id="@+id/switch_account_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_switch_account" />
                <com.google.android.material.button.MaterialButton android:id="@+id/sign_out_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_sign_out" />
                <com.google.android.material.button.MaterialButton android:id="@+id/walkthrough_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_walkthrough" />
                <com.google.android.material.button.MaterialButton android:id="@+id/theme_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_theme_system" />
                <com.google.android.material.button.MaterialButton android:id="@+id/about_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_about_button" />
                <com.google.android.material.button.MaterialButton android:id="@+id/classroom_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_classroom" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/owner_manage_users_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_owner_manage_users" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/owner_feedback_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_owner_feedback" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/owner_analytics_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_owner_analytics" android:visibility="gone" />
                <com.google.android.material.button.MaterialButton android:id="@+id/teacher_feedback_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_teacher_feedback" android:visibility="gone" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:text="@string/home_drawer_title" android:textColor="@color/text_primary_bright" android:textSize="18sp" android:textStyle="bold" />
                <TextView android:id="@+id/streak_value_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_streak_initial" android:textColor="@color/text_primary_bright" android:textSize="16sp" android:textStyle="bold" />
                <TextView android:id="@+id/goal_title_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="@string/home_goal_title" android:textColor="@color/text_support_soft" android:textSize="12sp" />
                <TextView android:id="@+id/goal_value_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/home_goal_initial" android:textColor="@color/text_primary_bright" android:textSize="16sp" android:textStyle="bold" />
                <com.google.android.material.card.MaterialCardView android:id="@+id/streak_card" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
                <com.google.android.material.card.MaterialCardView android:id="@+id/goal_card" android:layout_width="match_parent" android:layout_height="1dp" android:visibility="gone" />
                <TextView android:id="@+id/recent_activity_empty_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/home_recent_activity_empty" android:textColor="@color/text_muted_soft" android:textSize="12sp" />
                <LinearLayout android:id="@+id/recent_quizzes_container" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
                <TextView android:id="@+id/weak_topics_text" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:text="@string/home_weak_topics_empty" android:textColor="@color/text_muted_soft" android:textSize="12sp" />
                <com.google.android.material.chip.ChipGroup android:id="@+id/weak_topics_chip_group" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleLine="false" app:singleSelection="false" />
                <com.google.android.material.button.MaterialButton android:id="@+id/feedback_button" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="@string/home_feedback_button" app:icon="@drawable/ic_feedback_bubble" app:iconGravity="textStart" app:iconPadding="10dp" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:gravity="center" android:text="@string/home_drawer_creator_footer" android:textColor="@color/text_muted_soft" android:textSize="11sp" android:textStyle="bold" />
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:gravity="center" android:text="@string/home_drawer_version_footer" android:textColor="@color/text_support_soft" android:textSize="10sp" />
            </LinearLayout>
        </ScrollView>
    </androidx.drawerlayout.widget.DrawerLayout>
</FrameLayout>
