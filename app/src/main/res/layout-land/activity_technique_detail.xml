<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:clipToPadding="false"
    android:orientation="horizontal"
    android:padding="10dp">

    <LinearLayout
        android:id="@+id/detail_header_section"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="12dp"
        android:layout_weight="34"
        android:background="@color/surface_panel_alt"
        android:orientation="vertical"
        android:padding="14dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/detail_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Linear Search"
                    android:textColor="#F8FAFC"
                    android:textSize="24sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_definition"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#DEE8F2"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/detail_real_life_example"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#A9BCD0"
                    android:textSize="12sp" />

                <TextView
                    android:id="@+id/detail_source"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#93C5FD"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/detail_version"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#94A3B8"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/detail_best"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:textColor="#86EFAC"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_average"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FCD34D"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_worst"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#FDA4AF"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/detail_space"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="#7DD3FC"
                    android:textStyle="bold" />
            </LinearLayout>
        </ScrollView>

        <TextView
            android:id="@+id/detail_flow_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="Learning Flow"
            android:textColor="#DDE7F1"
            android:textSize="12sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/detail_flow_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_understand"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/tab_understand"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_visualize"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/tab_visualize"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_practice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/tab_practice"
                android:textAllCaps="false"
                android:textSize="11sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_code"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="match_parent"
                android:layout_height="42dp"
                android:text="@string/tab_code"
                android:textAllCaps="false"
                android:textSize="11sp" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/detail_fragment_container"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="66" />
</LinearLayout>
