<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/visual_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/slate_950"
    android:clipChildren="true"
    android:clipToPadding="true"
    android:orientation="horizontal"
    android:paddingStart="4dp"
    android:paddingTop="2dp"
    android:paddingEnd="4dp"
    android:paddingBottom="4dp">

    <LinearLayout
        android:id="@+id/visual_landscape_left_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="58"
        android:clipChildren="true"
        android:clipToPadding="true"
        android:orientation="vertical">

        <TextView
            android:id="@+id/visual_topic_name"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:background="@color/surface_panel_muted"
            android:gravity="center_vertical"
            android:letterSpacing="0.04"
            android:maxLines="1"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="Technique"
            android:textAllCaps="true"
            android:textColor="@color/text_primary_soft"
            android:textSize="11sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:background="@drawable/code_surface_background"
            android:fadeScrollbars="false"
            android:fillViewport="true"
            android:padding="2dp"
            android:scrollbarStyle="outsideInset"
            android:scrollbars="horizontal">

            <TextView
                android:id="@+id/visual_live_pseudocode"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:breakStrategy="simple"
                android:fontFamily="monospace"
                android:gravity="center_vertical"
                android:hyphenationFrequency="none"
                android:maxLines="1"
                android:paddingStart="14dp"
                android:paddingEnd="16dp"
                android:scrollHorizontally="true"
                android:textColor="@color/text_primary_bright"
                android:textSize="13sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </HorizontalScrollView>

        <FrameLayout
            android:id="@+id/matrixContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="2dp"
            android:layout_weight="1"
            android:background="@color/surface_panel_alt"
            android:clipChildren="true"
            android:clipToPadding="true"
            android:padding="8dp">

            <HorizontalScrollView
                android:id="@+id/visualizer_scroll_container"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipChildren="true"
                android:clipToPadding="true"
                android:fillViewport="true"
                android:overScrollMode="never"
                android:scrollbars="none">

                <com.dsavisualizer.app.ui.view.TechniqueVisualizerView
                    android:id="@+id/technique_visualizer"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />
            </HorizontalScrollView>

            <LinearLayout
                android:id="@+id/visual_overlay_actions_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="vertical"
                android:padding="8dp"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/visual_landscape_info_pane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_marginEnd="6dp"
        android:layout_weight="34"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/visual_study_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_panel_alt"
            android:orientation="vertical"
            android:padding="8dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/visual_study_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/text_primary_bright"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/visual_study_exit_button"
                style="@style/Widget.DSA.Button.Text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/vis_btn_exit_study" />

            <LinearLayout
                android:id="@+id/visual_study_chip_row"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/visual_study_chip_primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:textColor="@color/text_chip_blue"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/visual_study_chip_secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:textColor="@color/text_chip_teal"
                    android:textSize="10sp" />

                <TextView
                    android:id="@+id/visual_study_chip_tertiary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:padding="5dp"
                    android:textColor="@color/text_chip_violet"
                    android:textSize="10sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/visual_study_actions_host"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/visual_study_message"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="2"
                android:textColor="@color/text_secondary"
                android:textSize="11sp" />

            <LinearLayout
                android:id="@+id/visual_study_controls_strip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:visibility="gone">

                <com.google.android.material.button.MaterialButton android:id="@+id/visual_study_previous_button" style="@style/Widget.DSA.Button.Playback" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Prev" app:icon="@drawable/ic_player_prev" />
                <com.google.android.material.button.MaterialButton android:id="@+id/visual_study_replay_button" style="@style/Widget.DSA.Button.Playback.Restart" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Restart" app:icon="@drawable/ic_player_replay" />
                <com.google.android.material.button.MaterialButton android:id="@+id/visual_study_play_button" style="@style/Widget.DSA.Button.Playback.Primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Play" app:icon="@drawable/ic_player_play" />
                <com.google.android.material.button.MaterialButton android:id="@+id/visual_study_next_button" style="@style/Widget.DSA.Button.Playback" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Next" app:icon="@drawable/ic_player_next" />
            </LinearLayout>
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/visual_prediction_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/visual_content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="false"
            android:scrollbars="vertical">

            <LinearLayout
                android:id="@+id/visual_landscape_scroll_content"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="8dp">

                <LinearLayout
                    android:id="@+id/visual_traversal_group"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:background="@color/surface_panel_muted"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="8dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/visual_traversal_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/vis_traversal"
                        android:textColor="@color/text_primary_bright"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <Spinner
                        android:id="@+id/visual_traversal_spinner"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1" />
                </LinearLayout>

                <TextView
                    android:id="@+id/visual_status_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface_panel_muted"
                    android:padding="10dp"
                    android:textColor="@color/text_primary_bright"
                    android:textSize="13sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/visual_explanation_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface_panel_muted"
                    android:lineSpacingExtra="2dp"
                    android:padding="10dp"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp" />

                <LinearLayout android:id="@+id/visual_difficulty_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><Spinner android:id="@+id/visual_difficulty_spinner" android:layout_width="match_parent" android:layout_height="wrap_content" /></LinearLayout>

                <LinearLayout
                    android:id="@+id/visual_input_row"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/visual_values_input_layout" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/visual_values_input" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout
                        android:id="@+id/visual_compact_limit_group"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:visibility="gone">
                        <TextView
                            android:id="@+id/visual_limit_chip_label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/surface_chip_background"
                            android:paddingStart="10dp"
                            android:paddingTop="7dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="7dp"
                            android:text="@string/vis_structure_limit_hint"
                            android:textColor="@color/text_primary_soft"
                            android:textSize="11sp"
                            android:textStyle="bold" />
                        <com.google.android.material.textfield.TextInputLayout
                            android:id="@+id/visual_compact_limit_input_layout"
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="72dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            app:boxBackgroundColor="#132234">
                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/visual_compact_limit_input"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:inputType="number"
                                android:maxLines="1"
                                android:textColor="@color/text_primary_bright" />
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/visual_target_input_layout" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/visual_target_input" android:layout_width="match_parent" android:layout_height="wrap_content" /></com.google.android.material.textfield.TextInputLayout>
                </LinearLayout>

                <LinearLayout android:id="@+id/visual_input_actions_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><com.google.android.material.button.MaterialButton android:id="@+id/visual_random_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/visual_apply_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /></LinearLayout>

                <LinearLayout
                    android:id="@+id/visual_operations_group"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@color/surface_panel_muted"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone">
                    <TextView android:id="@+id/visual_operations_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vis_operations" android:textColor="@color/text_primary_bright" android:textSize="12sp" />
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/visual_operation_input_layout" android:layout_width="match_parent" android:layout_height="wrap_content"><com.google.android.material.textfield.TextInputEditText android:id="@+id/visual_operation_input" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" /></com.google.android.material.textfield.TextInputLayout>
                    <LinearLayout android:id="@+id/visual_operation_row_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/visual_operation_primary_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/visual_operation_secondary_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /></LinearLayout>
                    <LinearLayout android:id="@+id/visual_operation_row_secondary" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"><com.google.android.material.button.MaterialButton android:id="@+id/visual_operation_tertiary_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /><com.google.android.material.button.MaterialButton android:id="@+id/visual_operation_fourth_button" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" /></LinearLayout>
                </LinearLayout>

                <TextView android:id="@+id/visual_timeline_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
                <HorizontalScrollView android:id="@+id/visual_timeline_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><LinearLayout android:id="@+id/visual_timeline_row" android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal" /></HorizontalScrollView>

                <LinearLayout android:id="@+id/visual_pointer_legend_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/surface_panel_muted" android:orientation="vertical" android:padding="8dp" android:visibility="gone"><TextView android:id="@+id/visual_pointer_legend_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary_soft" /><TextView android:id="@+id/visual_pointer_legend_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" /></LinearLayout>
                <LinearLayout android:id="@+id/visual_formula_row" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/surface_panel_muted" android:orientation="vertical" android:padding="8dp" android:visibility="gone"><TextView android:id="@+id/visual_formula_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary_soft" /><TextView android:id="@+id/visual_formula_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" /><com.google.android.material.button.MaterialButton android:id="@+id/visual_formula_toggle_button" android:layout_width="wrap_content" android:layout_height="wrap_content" /></LinearLayout>
                <LinearLayout android:id="@+id/visual_state_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/surface_panel_muted" android:orientation="vertical" android:padding="8dp" android:visibility="gone"><TextView android:id="@+id/visual_state_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="State" android:textColor="@color/text_primary_soft" /><TextView android:id="@+id/visual_state_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" /></LinearLayout>
                <LinearLayout android:id="@+id/visual_adjacency_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@color/surface_panel_muted" android:orientation="vertical" android:padding="8dp" android:visibility="gone"><TextView android:id="@+id/visual_adjacency_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Adjacency" android:textColor="@color/text_primary_soft" /><TextView android:id="@+id/visual_adjacency_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" /></LinearLayout>
                <com.google.android.material.card.MaterialCardView android:id="@+id/visual_completion_banner" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/visual_completion_banner_title" android:layout_width="match_parent" android:layout_height="wrap_content" /><TextView android:id="@+id/visual_completion_banner_body" android:layout_width="match_parent" android:layout_height="wrap_content" /></LinearLayout></com.google.android.material.card.MaterialCardView>
                <com.google.android.material.card.MaterialCardView android:id="@+id/visual_step_details_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:visibility="gone" app:cardBackgroundColor="@color/surface_card_frosted" app:cardCornerRadius="16dp"><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="10dp"><TextView android:id="@+id/visual_step_details_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/vis_step_details" android:textColor="@color/text_primary_soft" android:textSize="13sp" android:textStyle="bold" /><TextView android:id="@+id/visual_step_details_body" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_body_soft" android:textSize="11sp" /></LinearLayout></com.google.android.material.card.MaterialCardView>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/visual_controls_group"
        android:layout_width="86dp"
        android:layout_height="match_parent"
        android:background="@drawable/player_bar_background"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="7dp"
        android:paddingTop="8dp"
        android:paddingEnd="7dp"
        android:paddingBottom="8dp">

        <TextView android:id="@+id/visual_now_doing_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_primary_soft" android:textSize="10sp" android:visibility="gone" />
        <TextView android:id="@+id/visual_step_chip" android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/surface_chip_background" android:padding="5dp" android:text="0/0" android:textColor="@color/text_primary_soft" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/visual_completed_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:background="@drawable/surface_chip_background" android:padding="5dp" android:text="Done" android:textColor="@color/text_primary_soft" android:textSize="9sp" android:visibility="gone" />
        <TextView android:id="@+id/visual_progress_label" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:gravity="center" android:textColor="@color/text_muted_soft" android:textSize="9sp" />
        <FrameLayout android:id="@+id/visual_progress_track" android:layout_width="match_parent" android:layout_height="18dp" android:layout_marginTop="4dp"><TextView android:id="@+id/visual_progress_badge" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" /><ProgressBar android:id="@+id/visual_progress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="5dp" android:layout_gravity="center" android:max="100" /><View android:id="@+id/visual_progress_handle" android:layout_width="10dp" android:layout_height="10dp" android:layout_gravity="start|center_vertical" android:background="@drawable/player_progress_handle_background" /></FrameLayout>
        <TextView android:id="@+id/visual_controls_hint_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:visibility="gone" />

        <LinearLayout
            android:id="@+id/visual_controls_strip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:orientation="vertical">
            <com.google.android.material.button.MaterialButton android:id="@+id/visual_previous_button" style="@style/Widget.DSA.Button.Playback" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Prev" app:icon="@drawable/ic_player_prev" />
            <com.google.android.material.button.MaterialButton android:id="@+id/visual_replay_button" style="@style/Widget.DSA.Button.Playback.Restart" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Restart" app:icon="@drawable/ic_player_replay" />
            <com.google.android.material.button.MaterialButton android:id="@+id/visual_start_pause_button" style="@style/Widget.DSA.Button.Playback.Primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Play" app:icon="@drawable/ic_player_play" />
            <com.google.android.material.button.MaterialButton android:id="@+id/visual_step_button" style="@style/Widget.DSA.Button.Playback" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:text="Next" app:icon="@drawable/ic_player_next" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton android:id="@+id/visual_edit_input_button" style="@style/Widget.DSA.Button.Outlined" android:layout_width="match_parent" android:layout_height="42dp" android:layout_marginTop="6dp" android:contentDescription="@string/vis_edit_input" android:insetLeft="0dp" android:insetRight="0dp" android:minWidth="0dp" android:paddingStart="0dp" android:paddingEnd="0dp" android:text="" app:icon="@drawable/ic_edit" app:iconGravity="textStart" app:iconPadding="0dp" app:iconTint="@color/text_primary_bright" />
        <View android:id="@+id/visual_controls_progress_line" android:layout_width="match_parent" android:layout_height="2dp" android:layout_marginTop="6dp" android:background="@color/text_primary_soft" android:scaleX="0" />
        <com.google.android.material.button.MaterialButton android:id="@+id/visual_reset_button" style="@style/Widget.DSA.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
        <com.google.android.material.button.MaterialButton android:id="@+id/visual_focus_button" style="@style/Widget.DSA.Button.Outlined" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
