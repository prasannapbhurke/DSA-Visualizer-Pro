<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Base.Theme.DSA" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Brand & Accents (Cyber Neon) -->
        <item name="colorPrimary">@color/sky_400</item>
        <item name="colorSecondary">@color/amber_500</item>
        <item name="colorTertiary">@color/emerald_400</item>

        <!-- Full Edge-to-Edge System Bars (Cyber-Dark Theme) -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">false</item>

        <!-- Background & Surface Hierarchy -->
        <item name="android:windowBackground">@color/window_background</item>
        <item name="android:colorBackground">@color/window_background</item>
        <item name="colorSurface">@color/surface_card</item>
        <item name="colorOnSurface">@color/text_primary_bright</item>
        <item name="android:textColor">@color/text_primary_bright</item>
        <item name="android:textColorPrimary">@color/text_primary_bright</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
    </style>
</resources>
