<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:minHeight="68dp"
    android:orientation="horizontal"
    android:paddingStart="14dp"
    android:paddingTop="10dp"
    android:paddingEnd="14dp"
    android:paddingBottom="10dp">

    <TextView
        android:id="@+id/option_badge"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:background="@drawable/badge_background"
        android:gravity="center"
        android:text="SO"
        android:textColor="@color/algorithm_option_badge_text"
        android:textSize="11sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/option_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Bubble Sort"
            android:textColor="@color/algorithm_option_title"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/option_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="Repeated passes compare adjacent elements."
            android:textColor="@color/algorithm_option_subtitle"
            android:textSize="12sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/option_difficulty"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/surface_chip_background"
        android:paddingStart="10dp"
        android:paddingTop="6dp"
        android:paddingEnd="10dp"
        android:paddingBottom="6dp"
        android:text="Easy"
        android:textColor="@color/algorithm_option_difficulty"
        android:textSize="11sp"
        android:textStyle="bold" />

</LinearLayout>
