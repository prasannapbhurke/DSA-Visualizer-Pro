<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/login_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="28dp"
        android:paddingTop="48dp"
        android:paddingEnd="28dp"
        android:paddingBottom="36dp">

        <TextView
            android:id="@+id/login_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/badge_background"
            android:paddingStart="18dp"
            android:paddingTop="9dp"
            android:paddingEnd="18dp"
            android:paddingBottom="9dp"
            android:text="@string/app_name"
            android:textAllCaps="true"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_caption_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/login_title"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_login_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/login_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:gravity="center"
            android:text="@string/login_subtitle"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/dsa_login_subtitle_text" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/login_setup_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="34dp"
            app:cardBackgroundColor="@color/surface_panel_muted"
            app:cardCornerRadius="26dp"
            app:strokeColor="@color/surface_stroke_muted"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/drawer_badge_background"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="4dp"
                    android:text="@string/login_status_label"
                    android:textColor="@color/text_hint_blue"
                    android:textSize="@dimen/dsa_caption_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/login_setup_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="@string/login_setup_missing_title"
                    android:textColor="@color/text_primary_bright"
                    android:textSize="@dimen/dsa_section_title_text"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/login_setup_message"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/login_setup_missing_body"
                    android:textColor="@color/text_muted"
                    android:textSize="@dimen/dsa_body_text" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/google_sign_in_button"
            style="@style/Widget.Material3.Button"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="26dp"
            android:minHeight="58dp"
            android:text="@string/login_google_button" />

        <TextView
            android:id="@+id/login_creator_credit"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center"
            android:text="@string/login_creator_credit"
            android:textColor="@color/text_muted_soft"
            android:textSize="@dimen/dsa_body_small_text"
            android:textStyle="bold" />

    </LinearLayout>
</ScrollView>
