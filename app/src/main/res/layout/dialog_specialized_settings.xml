<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_nqueens_dialog"
        android:paddingStart="24dp"
        android:paddingTop="26dp"
        android:paddingEnd="24dp"
        android:paddingBottom="26dp">

        <!-- Title: Specialized & Math Algorithm Setup -->
        <TextView
            android:id="@+id/spec_settings_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="Specialized &amp; Math Algorithm Setup"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <!-- Subtitle -->
        <TextView
            android:id="@+id/spec_settings_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:gravity="center"
            android:text="Select a curated scenario or customize input sequence / parameters."
            android:textColor="#94A3B8"
            android:textSize="13sp" />

        <!-- Section 1 Header: Curated Scenarios -->
        <TextView
            android:id="@+id/spec_preset_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="Curated Scenarios"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Preset Selection Buttons (Preset 1, Preset 2, Preset 3) -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/spec_preset_1"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginEnd="4dp"
                android:text="Standard"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/spec_preset_2"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:text="Edge / Stress"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/spec_preset_3"
                android:layout_width="0dp"
                android:layout_height="46dp"
                android:layout_weight="1"
                android:layout_marginStart="4dp"
                android:text="Dense / Complex"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:textStyle="bold"
                app:cornerRadius="14dp"
                android:insetTop="0dp"
                android:insetBottom="0dp" />
        </LinearLayout>

        <!-- Preset Description Card -->
        <LinearLayout
            android:id="@+id/spec_desc_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@drawable/bg_nqueens_dialog"
            android:orientation="vertical"
            android:padding="14dp">

            <TextView
                android:id="@+id/spec_preset_desc_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Scenario Details:"
                android:textColor="#34D399"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/spec_preset_desc_detail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Mathematical steps, invariants and complexities."
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:lineSpacingExtra="2dp" />
        </LinearLayout>

        <!-- Section 2 Header: Custom Input -->
        <TextView
            android:id="@+id/spec_custom_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:text="Custom Inputs / Parameters"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/spec_custom_helper"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Enter comma-separated coordinates, integers, equations, or intervals"
            android:textColor="#94A3B8"
            android:textSize="12sp" />

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/spec_custom_input_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Input Values"
            app:boxBackgroundColor="#131B2E"
            app:boxStrokeColor="#10B981"
            app:boxCornerRadiusTopStart="12dp"
            app:boxCornerRadiusTopEnd="12dp"
            app:boxCornerRadiusBottomStart="12dp"
            app:boxCornerRadiusBottomEnd="12dp"
            app:hintTextColor="#10B981"
            android:textColorHint="#64748B">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/spec_custom_input"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:inputType="textNoSuggestions"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Apply & Close button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/spec_btn_close"
            android:layout_width="148dp"
            android:layout_height="46dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="22dp"
            android:text="Apply &amp; Close"
            android:textAllCaps="false"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            app:backgroundTint="#059669"
            app:cornerRadius="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp" />

    </LinearLayout>
</ScrollView>
