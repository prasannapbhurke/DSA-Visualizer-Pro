<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/detail_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/detail_header_section"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="4dp">

        <TextView
            android:id="@+id/detail_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Linear Search"
            android:textColor="#F8FAFC"
            android:textSize="@dimen/dsa_screen_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/detail_definition"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#DEE8F2"
            android:textSize="@dimen/dsa_body_text" />

        <TextView
            android:id="@+id/detail_real_life_example"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#A9BCD0"
            android:textSize="@dimen/dsa_body_text" />

        <TextView
            android:id="@+id/detail_source"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="#93C5FD"
            android:textSize="@dimen/dsa_caption_text" />

        <TextView
            android:id="@+id/detail_version"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="#94A3B8"
            android:textSize="@dimen/dsa_caption_text" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_best"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#86EFAC"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_average"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#FCD34D"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/detail_worst"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textColor="#FDA4AF"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detail_space"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:textColor="#7DD3FC"
                android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/detail_flow_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Learning Flow"
            android:textColor="#DDE7F1"
            android:textSize="@dimen/dsa_body_text"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/detail_flow_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_understand"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:text="@string/tab_understand"
                android:textAllCaps="false"
                android:textSize="@dimen/dsa_flow_chip_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_visualize"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:text="@string/tab_visualize"
                android:textAllCaps="false"
                android:textSize="@dimen/dsa_flow_chip_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_practice"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:text="@string/tab_practice"
                android:textAllCaps="false"
                android:textSize="@dimen/dsa_flow_chip_text" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/detail_flow_code"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-condensed"
                android:insetLeft="0dp"
                android:insetRight="0dp"
                android:minHeight="48dp"
                android:minWidth="0dp"
                android:paddingLeft="1dp"
                android:paddingRight="1dp"
                android:text="@string/tab_code"
                android:textAllCaps="false"
                android:textSize="@dimen/dsa_flow_chip_text" />
        </com.google.android.material.button.MaterialButtonToggleGroup>
    </LinearLayout>

    <FrameLayout
        android:id="@+id/detail_fragment_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1" />

</LinearLayout>
