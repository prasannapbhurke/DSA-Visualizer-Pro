<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background">

    <LinearLayout
        android:id="@+id/student_detail_root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/student_detail_back_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/classroom_back"
                android:padding="10dp"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/text_primary_bright" />

            <TextView
                android:id="@+id/student_detail_title_text"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/classroom_student_default_name"
                android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_screen_title_text"
            android:textStyle="bold" />
        </LinearLayout>

        <TextView
            android:id="@+id/student_detail_summary_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/text_muted"
            android:textSize="@dimen/dsa_body_text" />

        <TextView
            android:id="@+id/student_detail_class_name_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted_soft"
            android:textSize="@dimen/dsa_body_small_text" />

        <ProgressBar
            android:id="@+id/student_detail_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:indeterminate="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/student_detail_weak_topics_title"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_section_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/student_detail_weak_topics_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted_soft"
            android:textSize="@dimen/dsa_body_small_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/student_detail_recent_title"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_section_title_text"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/student_detail_recent_activity_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:textColor="@color/text_muted_soft"
            android:textSize="@dimen/dsa_body_small_text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/student_detail_progress_title"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_section_title_text"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/student_detail_progress_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:id="@+id/student_detail_notes_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/student_detail_teacher_notes_title"
                android:textColor="@color/text_primary_bright"
                android:textSize="@dimen/dsa_section_title_text"
                android:textStyle="bold" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/student_detail_add_feedback_button"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="0dp"
                android:text="@string/student_detail_add_feedback" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/student_detail_view_resources_button"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/class_resources_button" />

        <TextView
            android:id="@+id/student_detail_empty_notes_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/student_detail_teacher_notes_empty"
            android:textColor="@color/text_muted_soft"
            android:textSize="@dimen/dsa_body_small_text"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/student_detail_notes_container"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </LinearLayout>

</ScrollView>
