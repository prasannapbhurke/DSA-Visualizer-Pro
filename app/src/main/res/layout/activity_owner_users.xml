<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/owner_users_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/main_background"
    android:orientation="vertical"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/owner_users_back_button"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/owner_users_back"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_back"
            android:tint="@color/text_primary_bright" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="@string/owner_users_title"
            android:textColor="@color/text_primary_bright"
            android:textSize="@dimen/dsa_screen_title_text"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/owner_users_subtitle"
        android:textColor="@color/text_muted"
        android:textSize="@dimen/dsa_body_text" />

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        app:cardBackgroundColor="@color/surface_panel_info"
        app:cardCornerRadius="22dp"
        app:strokeColor="@color/surface_stroke_muted"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/owner_users_card_title"
                android:textColor="@color/text_primary_soft"
                android:textSize="@dimen/dsa_card_title_text"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/owner_users_summary_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/owner_users_summary_empty"
                android:textColor="@color/text_primary_bright"
                android:textSize="@dimen/dsa_section_title_text"
                android:textStyle="bold" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:letterSpacing="0.12"
        android:text="@string/owner_users_sort_by"
        android:textAllCaps="true"
        android:textColor="@color/text_muted_soft"
        android:textSize="11sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/owner_users_sort_spinner"
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/code_toolbar_background"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:popupBackground="@color/surface_panel_info" />

    <ProgressBar
        android:id="@+id/owner_users_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="18dp"
        android:indeterminate="true" />

    <TextView
        android:id="@+id/owner_users_empty_text"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="@string/owner_users_empty"
        android:textColor="@color/text_muted_soft"
        android:textSize="@dimen/dsa_body_text"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/owner_users_recycler_view"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/owner_users_retry_button"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/owner_users_refresh_button" />

</LinearLayout>
