<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/logic_scroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/main_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="10dp"
        android:paddingBottom="28dp">

        <!-- Header card: problem title + pattern badge -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logic_header_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardBackgroundColor="@color/surface_panel_info"
            app:cardCornerRadius="16dp"
            app:strokeColor="@color/surface_stroke_muted"
            app:strokeWidth="1dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp">

                <!-- Tiny label -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🧠 Logic Block — Think Before You Code"
                    android:textColor="@color/amber_500"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04" />

                <!-- Problem title -->
                <TextView
                    android:id="@+id/logic_header_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text_primary_bright"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:lineSpacingExtra="2dp" />

                <!-- Pattern badge -->
                <TextView
                    android:id="@+id/logic_pattern_badge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_difficulty_badge"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="3dp"
                    android:textColor="@color/sky_400"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Main content card -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/logic_content_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="@color/surface_card"
            app:cardCornerRadius="18dp"
            app:strokeColor="@color/surface_stroke_muted"
            app:strokeWidth="1dp"
            app:cardElevation="2dp">

            <TextView
                android:id="@+id/logic_content_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:lineSpacingExtra="4dp"
                android:padding="18dp"
                android:textColor="@color/text_primary_soft"
                android:textSize="13sp" />

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
