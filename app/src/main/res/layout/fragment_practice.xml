<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/practice_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/prediction_mode"
            android:textColor="@color/text_primary_bright"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/practice_topic_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/surface_panel_muted"
            android:letterSpacing="0.03"
            android:paddingStart="10dp"
            android:paddingTop="7dp"
            android:paddingEnd="10dp"
            android:paddingBottom="7dp"
            android:text="Technique"
            android:textColor="@color/text_primary_soft"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/practice_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/prediction_mode_subtitle"
            android:textColor="@color/text_support_soft"
            android:textSize="14sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Mode"
            android:textColor="@color/text_secondary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/practice_mode_toggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:selectionRequired="true"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practice_mode_theory"
                style="@style/Widget.DSA.Button.Toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Theory" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practice_mode_practical"
                style="@style/Widget.DSA.Button.Toggle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Practical" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <TextView
            android:id="@+id/practice_state_summary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@color/surface_panel_alt"
            android:padding="14dp"
            android:textColor="@color/slate_100"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/practice_hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@color/surface_panel_info"
            android:padding="12dp"
            android:textColor="@color/text_hint_blue"
            android:textSize="14sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/practice_question"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/surface_panel_muted"
            android:padding="14dp"
            android:textColor="@color/slate_100"
            android:textSize="15sp" />

        <RadioGroup
            android:id="@+id/practice_options_group"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practice_check_button"
                style="@style/Widget.DSA.Button.Primary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/check_answer" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/practice_next_button"
                style="@style/Widget.DSA.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:text="@string/refresh_step" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/practice_review_button"
            style="@style/Widget.DSA.Button.Secondary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:text="@string/practice_review_mistakes" />

        <TextView
            android:id="@+id/practice_feedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:background="@color/surface_panel_deep"
            android:padding="14dp"
            android:textColor="@color/text_secondary"
            android:textSize="14sp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
